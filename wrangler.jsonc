{
  // Cloudflare Workers deploy: the built static site in dist/ is served from the
  // asset layer; /data/* is proxied to the R2 dataset bucket by src/worker.ts
  // (same-origin, so the front-end needs no CORS and the r2.dev URL never
  // appears publicly). VITE_DATASET_BASE stays unset — the app's default
  // /data hits the proxy.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "spatial-bench-web",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/data/*"]
  },
  "r2_buckets": [
    {
      "binding": "DATASET",
      "bucket_name": "spatial-bench"
    }
  ]
}
