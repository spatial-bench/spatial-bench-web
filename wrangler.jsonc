{
  // Cloudflare Workers static-assets deploy: the built SPA in dist/ is served
  // directly; not_found_page routes SPA paths back to index.html. The dataset
  // base (VITE_DATASET_BASE) is set as a build variable in the dashboard, not
  // here — it is baked at build time by Vite.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "spatial-bench-web",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
