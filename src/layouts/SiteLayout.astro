---
import "../index.css";

interface Props {
  title: string;
  description: string;
  home?: boolean;
  wide?: boolean;
  headings?: { depth: number; slug: string; text: string }[];
}
const { title, description, home = false, wide = false, headings } = Astro.props;
const links = [
  ["/explore", "Explore results"],
  ["/guide", "Reading guide"],
  ["/methodology", "Methodology"],
  ["/coverage", "Coverage"],
  ["/about", "About the project"],
  ["/contribute", "Contribute"],
  ["/updates", "Updates"],
];
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const contents = headings?.filter((h) => h.depth === 2) ?? [];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title} · spatial-bench</title>
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <header class="site-header">
      <a class="brand" href="/" aria-label="spatial-bench home">
        <svg viewBox="0 0 32 32" width="30" height="30" aria-hidden="true">
          <path
            d="M6 24 13 8 26 15 6 24M13 8l5 18"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
          />
          <g fill="currentColor">
            <circle cx="6" cy="24" r="3" />
            <circle cx="13" cy="8" r="3" />
            <circle cx="26" cy="15" r="3" />
            <circle cx="18" cy="26" r="2" />
          </g>
        </svg>
        spatial-bench
      </a>
      <nav class="header-links" aria-label="Quick links">
        <a
          href="/explore"
          aria-current={path === "/explore" ? "page" : undefined}
        >
          Explore results
        </a>
        <a
          href="/methodology"
          aria-current={path === "/methodology" ? "page" : undefined}
        >
          Methodology
        </a>
        <a
          href="/contribute"
          aria-current={path === "/contribute" ? "page" : undefined}
        >
          Contribute
        </a>
      </nav>
      <details class="site-menu">
        <summary>
          <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true">
            <path
              d="M2 5h16M2 10h16M2 15h16"
              stroke="currentColor"
              stroke-width="1.5"
            />
          </svg>
          <span>Menu</span>
        </summary>
        <nav aria-label="Main navigation">
          <a href="/" aria-current={path === "/" ? "page" : undefined}>
            Home
          </a>
          {links.map(([href, label]) => (
            <a href={href} aria-current={path === href ? "page" : undefined}>
              {label}
            </a>
          ))}
        </nav>
      </details>
    </header>
    <div class:list={["site-body", { "docs-grid": !!headings }]}>
      {headings && (
        <aside class="doc-sidebar">
          <a class="sidebar-label" href="/about">
            Project documentation
          </a>
          <nav aria-label="Documentation">
            {links
              .filter(([href]) => href !== "/explore")
              .map(([href, label]) => (
                <a
                  href={href}
                  aria-current={path === href ? "page" : undefined}
                >
                  {label}
                </a>
              ))}
          </nav>
          {contents.length > 0 && (
            <nav class="page-contents" aria-label="On this page">
              <span class="sidebar-label">On this page</span>
              {contents.map((h) => (
                <a href={`#${h.slug}`}>{h.text}</a>
              ))}
            </nav>
          )}
        </aside>
      )}
      <main id="main" class:list={["page", { wide, home }]} tabindex="-1">
        {!home && (
          <header class="page-heading">
            <p class="eyebrow">
              {headings ? "Documentation" : "Benchmark results"}
            </p>
            <h1>{title}</h1>
            <p class="page-description">{description}</p>
          </header>
        )}
        {contents.length > 0 && (
          <details class="mobile-contents">
            <summary>On this page</summary>
            <nav aria-label="Page contents">
              {contents.map((h) => (
                <a href={`#${h.slug}`}>{h.text}</a>
              ))}
            </nav>
          </details>
        )}
        <slot />
      </main>
    </div>
    <footer class="site-footer">
      <a class="brand" href="/">
        spatial-bench
      </a>
      <span>Spatial index benchmarks</span>
      <nav aria-label="Footer">
        <a href="/about">About</a>
        <a href="/contribute">Contribute</a>
        <a href="https://github.com/spatial-bench">GitHub</a>
      </nav>
    </footer>
  </body>
</html>
